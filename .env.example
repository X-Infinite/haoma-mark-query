# 应用
SESSION_SECRET=请替换为随机长字符串
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# SQLite（可选，默认 ./data/app.db）
# DATABASE_PATH=./data/app.db

# 聚美智数 Jumdata
# mock = 本地模拟异步回调；live = 调用真实 API（需有效密钥）
JUMDATA_MODE=mock
JUMDATA_APP_ID=
JUMDATA_APP_SECRET=
# 公网可访问的回调根地址（live 模式必填，用于拼接 /api/webhooks/jumdata）
CALLBACK_BASE_URL=http://127.0.0.1:43123
# 可选：覆盖默认 API 地址
# JUMDATA_API_URL=https://api.jumdata.com/v1/phone/mark/async
# Webhook 验签（mock 默认 mock-webhook-secret）
JUMDATA_WEBHOOK_SECRET=mock-webhook-secret


# 支付宝（沙箱默认读取项目根 .alipay-sandbox.json；生产请设 ALIPAY_MODE=production）
# ALIPAY_MODE=sandbox
# 本地验收可暂不配置公网通知；有公网 HTTPS 后再填
# ALIPAY_NOTIFY_URL=https://your-tunnel.example/api/alipay/notify
# ALIPAY_PROJECT_ROOT=
# 生产环境（切勿把生产私钥提交到 Git）
# ALIPAY_MODE=production
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_SELLER_ID=
# ALIPAY_SELLER_EMAIL=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
